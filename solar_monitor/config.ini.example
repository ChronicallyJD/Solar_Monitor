# Solar Monitor — copy to config.ini and edit

[general]
output          = dashboard.html
interval        = 30
scan_timeout    = 10
max_history     = 60
log_level       = INFO
theme           = business

[bms]
# Name = MAC_OR_BLE_NAME [ : password ]
# Batt0 = DXDD00202J-117

[victron]
# Name = MAC : 32-hex-advertisement-key
# (from VictronConnect: device > gear > Product info >
#  Instant Readout via Bluetooth > Show > Advertisement key)
# MPPT    = DD:1B:7E:A7:91:83 : 613f9fd95d3633385cf49d32a9d551e3
# Inverter = E6:2E:31:75:9A:1A : dd15693279172720da3ecb1d2e4e7da1
